    "dropdown",
    "select-options",
    "autocomplete",
    "calling-codes",
    "phone-codes",
    "dial-codes",
    "currencies",
    "currency-codes",
    "alpha-3",
    "numeric-codes",
    "capitals",
    "capital-cities",
    "timezones",
    "iana-timezones",
    "chinese",
    "japanese"
