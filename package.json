{
  "name": "i18n-countries-continents",
  "version": "1.5.0",
  "description": "Get country, continent, and city names in 14 languages. 250 countries, 7 continents, 4,010 cities, ISO alpha-3/numeric codes, capitals, timezones, calling codes, currencies, ccTLD, native names, demonyms, coordinates, borders, EU/Schengen status, subregions, ISO 3166-2 subdivisions, and postal codes in en, es, fr, ar, nl, de, pt, it, zh, ja, ru, hi, ko, tr. Modular city subpath (/cities) reduces core country bundle size by ~90%. Dual ESM & CommonJS build.",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "sideEffects": false,
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup \"src/**/*.ts\" --format esm,cjs --dts --clean",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "dev": "npm run build && node scripts/dev-server.js",
    "demo": "node scripts/dev-server.js",
    "test": "node tests/run-all.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "countries",
    "continents",
    "cities",
    "languages",
    "multilanguage",
    "localization",
    "l10n",
