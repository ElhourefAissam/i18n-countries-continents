    "build": "tsc",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "node tests/run-all.js",
    "typecheck": "tsc --noEmit"
  },
