{
  "name": "i18n-countries-continents",
  "version": "1.0.5",
  "description": "Get country, continent, and city names in different languages. 250 countries, 7 continents, and 4,010 cities with 5 languages. Works in React, Angular, Vue, Node.js, and any JavaScript environment.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "sideEffects": false,
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "node tests/run-all.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "countries",
    "continents",
    "cities",
    "multilanguage",
    "localization",
    "l10n",
    "react",
    "angular",
    "vue",
    "svelte",
    "nextjs",
    "typescript",
    "country-codes",
    "country-names",
    "continent-names",
    "city-names",
    "flags",
    "iso-3166"
  ],
  "author": "Aissam EL Houref",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElhourefAissam/i18n-countries-continents.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ElhourefAissam/i18n-countries-continents/issues"
  },
  "homepage": "https://github.com/ElhourefAissam/i18n-countries-continents#readme",
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./get-country-name": {
      "import": "./dist/services/countries/get-country-name.js",
      "require": "./dist/services/countries/get-country-name.js",
      "types": "./dist/services/countries/get-country-name.d.ts"
    },
    "./get-country-flag": {
      "import": "./dist/services/countries/get-country-flag.js",
      "require": "./dist/services/countries/get-country-flag.js",
      "types": "./dist/services/countries/get-country-flag.d.ts"
    },
    "./get-countries": {
      "import": "./dist/services/countries/get-countries.js",
      "require": "./dist/services/countries/get-countries.js",
      "types": "./dist/services/countries/get-countries.d.ts"
    },
    "./get-continent-by-country": {
      "import": "./dist/services/countries/get-continent-by-country.js",
      "require": "./dist/services/countries/get-continent-by-country.js",
      "types": "./dist/services/countries/get-continent-by-country.d.ts"
    },
    "./get-continent-name": {
      "import": "./dist/services/continents/get-continent-name.js",
      "require": "./dist/services/continents/get-continent-name.js",
      "types": "./dist/services/continents/get-continent-name.d.ts"
    },
    "./get-continents": {
      "import": "./dist/services/continents/get-continents.js",
      "require": "./dist/services/continents/get-continents.js",
      "types": "./dist/services/continents/get-continents.d.ts"
    },
    "./get-city-name": {
      "import": "./dist/services/cities/get-city-name.js",
      "require": "./dist/services/cities/get-city-name.js",
      "types": "./dist/services/cities/get-city-name.d.ts"
    },
    "./get-cities": {
      "import": "./dist/services/cities/get-cities.js",
      "require": "./dist/services/cities/get-cities.js",
      "types": "./dist/services/cities/get-cities.d.ts"
    },
    "./search-cities": {
      "import": "./dist/services/cities/search-cities.js",
      "require": "./dist/services/cities/search-cities.js",
      "types": "./dist/services/cities/search-cities.d.ts"
    },
    "./get-country": {
      "import": "./dist/services/countries/get-country.js",
      "require": "./dist/services/countries/get-country.js",
      "types": "./dist/services/countries/get-country.d.ts"
    },
    "./get-country-by-name": {
      "import": "./dist/services/countries/get-country-by-name.js",
      "require": "./dist/services/countries/get-country-by-name.js",
      "types": "./dist/services/countries/get-country-by-name.d.ts"
    },
    "./search-countries": {
      "import": "./dist/services/countries/search-countries.js",
      "require": "./dist/services/countries/search-countries.js",
      "types": "./dist/services/countries/search-countries.d.ts"
    },
    "./get-countries-by-continent": {
      "import": "./dist/services/countries/get-countries-by-continent.js",
      "require": "./dist/services/countries/get-countries-by-continent.js",
      "types": "./dist/services/countries/get-countries-by-continent.d.ts"
    },
    "./is-valid-country-code": {
      "import": "./dist/services/validation/is-valid-country-code.js",
      "require": "./dist/services/validation/is-valid-country-code.js",
      "types": "./dist/services/validation/is-valid-country-code.d.ts"
    },
    "./is-valid-continent-code": {
      "import": "./dist/services/validation/is-valid-continent-code.js",
      "require": "./dist/services/validation/is-valid-continent-code.js",
      "types": "./dist/services/validation/is-valid-continent-code.d.ts"
    },
    "./is-valid-language": {
      "import": "./dist/services/validation/is-valid-language.js",
      "require": "./dist/services/validation/is-valid-language.js",
      "types": "./dist/services/validation/is-valid-language.d.ts"
    },
    "./to-select-options": {
      "import": "./dist/utils/to-select-options.js",
      "require": "./dist/utils/to-select-options.js",
      "types": "./dist/utils/to-select-options.d.ts"
    }
  }
}
